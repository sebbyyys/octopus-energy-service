# Copy to .env, restrict permissions, then supply locally generated secrets.
# Required: at least 32 characters. Deliberately blank; this example cannot start as-is.
OCTOPUS_SERVICE_TOKEN=
# Optional together: both blank selects offline/cache-only mode.
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=
# Compose overrides this to /app/data/octopus.sqlite3.
OCTOPUS_DB_PATH=./data/octopus.sqlite3
OCTOPUS_TIMEZONE=Europe/London
OCTOPUS_SYNC_INTERVAL_SECONDS=1800
OCTOPUS_INITIAL_DAYS=90
OCTOPUS_LOOKBACK_DAYS=7
OCTOPUS_PAYMENT_METHOD=DIRECT_DEBIT
# Exact meter ID from /v1/meters. No unit inference: configure kwh or m3 explicitly.
OCTOPUS_GAS_UNITS_JSON='{}'
OCTOPUS_CALORIFIC_VALUE=39.2
OCTOPUS_CORRECTION_FACTOR=1.02264
# Compose-only: localhost by default. See docs/deployment.md before LAN exposure.
OCTOPUS_BIND_ADDRESS=127.0.0.1
